# =====================================================================
# Telegram Bot Configuration
# =====================================================================

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Optional: Telegram API credentials from https://my.telegram.org (used by bypass_bot.py)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# =====================================================================
# Performance & Concurrency Settings
# =====================================================================
MAX_CONCURRENT_JOBS=3
MAX_QUEUE_DEPTH=20
PER_USER_JOB_LIMIT=2

# Timeouts
NAV_TIMEOUT_MS=90000
TOTAL_RESOLUTION_TIMEOUT_S=180
WARMUP_DELAY_MS=2500

# =====================================================================
# Browser / Playwright Settings
# =====================================================================
HEADLESS=true
# Optional proxy: http://user:pass@host:port
# PROXY_URL=

# =====================================================================
# Retry & Fallback Configuration
# =====================================================================
MAX_RETRIES=1
RETRY_BACKOFF_S=3.0
ENABLE_FALLBACK=true
# FALLBACK_API_URL=https://bypass.vip/api
# FALLBACK_API_KEY=your_key_here

# =====================================================================
# Logging
# =====================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

